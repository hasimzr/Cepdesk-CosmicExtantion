[Unit]
Description=CepDesk yerel ağ çalışma yardımcısı
After=graphical-session.target
PartOf=graphical-session.target

[Service]
Type=simple
ExecStart=%h/.local/bin/cepdesk serve
WorkingDirectory=%h
Restart=on-failure
RestartSec=3
UMask=0077
KillMode=control-group
TimeoutStopSec=5

[Install]
WantedBy=graphical-session.target
